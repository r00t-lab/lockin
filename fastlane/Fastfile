# Fastlane runs on the macOS runner, never on your machine.
#
# Signing note: this deliberately does NOT use `match`. Match keeps certificates in a
# second private git repo and needs its own password — three moving parts to debug
# blind on a machine you cannot see. Instead we hand Xcode an App Store Connect API
# key and let it create and renew profiles itself via -allowProvisioningUpdates.
# Fewer secrets, and nothing to rotate by hand.
#
# The API key must have the **Admin** role. App Manager is enough for uploading but
# not for cloud-managed distribution certificates, and the failure surfaces late and
# obscurely: the archive succeeds, then exportArchive reports "No profiles were found"
# for every target followed by "Cloud signing permission error".

require "base64"
require "fileutils"

default_platform(:ios)

platform :ios do

  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Build and ship a build to TestFlight"
  lane :beta do
    key_id = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true,
      in_house: false
    )

    # The key above is for fastlane's own API calls. xcodebuild cannot see it, and
    # without it -allowProvisioningUpdates has no account to work with — it reports
    # "No Accounts: Add a new account in Accounts settings" and then fails to find a
    # profile for every target. Write the key to disk and pass the flags explicitly.
    key_dir = File.expand_path("~/private_keys")
    FileUtils.mkdir_p(key_dir)
    key_path = File.join(key_dir, "AuthKey_#{key_id}.p8")
    File.write(key_path, Base64.decode64(ENV.fetch("ASC_KEY_CONTENT")))

    # Build number must be unique per upload, forever. The GitHub run number is
    # monotonic and free.
    #
    # Passed as a build setting rather than via increment_build_number: that action
    # shells out to agvtool, which requires VERSIONING_SYSTEM = apple-generic in the
    # project. This project is generated fresh by XcodeGen on every run, so setting it
    # at build time is both simpler and impossible to leave stale.
    build_number = ENV.fetch("GITHUB_RUN_NUMBER", Time.now.to_i.to_s)

    build_app(
      scheme: "Lockin",
      export_method: "app-store",
      # `project:`, not `xcodeproj:` — build_app and increment_build_number spell this
      # parameter differently, and fastlane only says so at runtime.
      project: "Lockin.xcodeproj",
      # build_app takes no api_key. The authentication reaches xcodebuild through these
      # three flags instead, which is what lets it create the four provisioning
      # profiles on the fly.
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath", key_path,
        "-authenticationKeyID", key_id,
        "-authenticationKeyIssuerID", issuer_id,
        "CURRENT_PROJECT_VERSION=#{build_number}"
      ].join(" "),
      export_options: {
        signingStyle: "automatic"
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      # TestFlight rejects uploads with no export-compliance answer. Lockin ships no
      # custom cryptography, so this is a truthful "no" and saves a manual click per build.
      distribute_external: false
    )
  end

  desc "Build a signed ad-hoc IPA for direct install, bypassing TestFlight"
  lane :adhoc do
    key_id = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true,
      in_house: false
    )

    key_dir = File.expand_path("~/private_keys")
    FileUtils.mkdir_p(key_dir)
    key_path = File.join(key_dir, "AuthKey_#{key_id}.p8")
    File.write(key_path, Base64.decode64(ENV.fetch("ASC_KEY_CONTENT")))

    # ad-hoc, not app-store: the profile embeds the registered device UDIDs, so the
    # IPA installs straight onto those phones. TestFlight is not involved at any point,
    # which is the entire reason this lane exists -- TestFlight's keychain on the target
    # device is throwing -34018 and cannot authenticate a download.
    build_app(
      scheme: "Lockin",
      export_method: "ad-hoc",
      project: "Lockin.xcodeproj",
      output_name: "Nagg.ipa",
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath", key_path,
        "-authenticationKeyID", key_id,
        "-authenticationKeyIssuerID", issuer_id,
        "CURRENT_PROJECT_VERSION=#{ENV.fetch('GITHUB_RUN_NUMBER', Time.now.to_i.to_s)}"
      ].join(" "),
      export_options: { signingStyle: "automatic" }
    )
  end
end
