<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      ═══════════════════════════════════════════════════════════════════════════════
      EXACT ALARM PERMISSIONS — read docs/ANDROID.md before touching these two lines.
      ═══════════════════════════════════════════════════════════════════════════════

      Play's rule: request USE_EXACT_ALARM *or* SCHEDULE_EXACT_ALARM, never both on the
      same device. The sdk-version bounds below guarantee that, with no gap and no
      overlap:

        API 26–30  neither permission exists; exact alarms need no permission at all.
        API 31–32  SCHEDULE_EXACT_ALARM only. Auto-granted on these two API levels,
                   but the user can revoke it in Settings, so AlarmScheduler still
                   checks canScheduleExactAlarms() and can send them to the
                   ACTION_REQUEST_SCHEDULE_EXACT_ALARM screen.
        API 33+    USE_EXACT_ALARM only. Always granted, never revocable, and gated by
                   Play review instead. Lockin qualifies: its core user-facing function
                   IS an alarm clock. You must still say so in the Play Console
                   declaration — see docs/ANDROID-SETUP.md.

      Do not "simplify" this by dropping the sdk bounds. Declaring both on one device
      is the exact thing that gets an app pulled.

      ⚠️ The policy text changes on 28 October 2026. If you ship after that date,
      re-read the current Play policy before submitting.
    -->
    <uses-permission
        android:name="android.permission.USE_EXACT_ALARM"
        android:minSdkVersion="33" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!--
      Android 14+ gates full-screen intents behind this permission. It is granted by
      default only to apps whose core function is alarms or calls — again, Lockin
      qualifies, and again it is reviewed. If it is ever denied the alarm degrades to a
      heads-up notification, which is a much weaker product, so MainActivity checks
      canUseFullScreenIntent() and offers the settings deep link.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
      Battery-optimisation exemption. Also Play-restricted, also on the allowed list for
      alarm clocks. If you would rather not carry the declaration, delete this line and
      BatteryOptimization.requestExemption() falls back to the generic settings screen,
      which needs no permission at all.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".LockinApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.Lockin"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Lockin"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The full-screen alarm. Everything here exists to make it appear over the
          lock screen with the screen already on:
            showOnLockScreen / turnScreenOn   — the manifest half of the API 27+ pair
            excludeFromRecents + noHistory=false — it must not linger in the switcher
            launchMode singleInstance         — a nag must reuse, not stack
            taskAffinity ""                   — keeps it out of MainActivity's task, so
                                                dismissing it never kills the main app
        -->
        <activity
            android:name=".alarm.AlarmRingActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:showWhenLocked="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.Lockin.Alarm" />

        <!--
          Keeps the ring alive when the full-screen intent is shown as a heads-up
          notification instead of taking over the screen (which is what happens when the
          device is unlocked and in use). Without it, an alarm that fires while the user
          is scrolling makes no sound at all.

          specialUse subtype must be justified in the Play Console. "mediaPlayback" is
          the common alternative but its policy language expects media-player UX, which
          this is not. See docs/ANDROID-SETUP.md.
        -->
        <service
            android:name=".alarm.AlarmRingService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="alarm_clock_ringing" />
        </service>

        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false"
            android:directBootAware="false" />

        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Re-arm after an app update too; alarms are dropped on reinstall. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- Some OEM ROMs (notably older HTC/Xiaomi) only send this one. -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Camera hand-off for the photo proof. Cache-only; nothing leaves the device. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Ship the bundled barcode model inside the APK rather than downloading it from
          Play Services on first use. Costs ~2 MB; buys a QR proof that works on a fresh
          install, offline, at 7am. Non-negotiable for this app.
        -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode" />

    </application>
</manifest>
