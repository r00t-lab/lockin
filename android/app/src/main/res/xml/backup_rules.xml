<?xml version="1.0" encoding="utf-8"?>
<!--
  Back up the commitments and the streaks; never back up a captured proof photo.

  Note what restoring does NOT bring back: scheduled alarms. AlarmManager registrations
  are per-device and per-install. BootReceiver handles reboots, and MY_PACKAGE_REPLACED
  handles updates, but a restore onto a new phone lands with commitments present and no
  alarms armed. Re-arming on first launch after a restore is a known gap — see the
  "known gaps" section of docs/ANDROID-SETUP.md.
-->
<full-backup-content>
    <include domain="file" path="commitments.json" />
    <include domain="sharedpref" path="lockin.xml" />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
