# Generated by XcodeGen on the runner. Never commit it — a stale .xcodeproj that
# disagrees with project.yml is the hardest bug to diagnose on a machine you can't see.
Lockin.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
*.ipa
*.dSYM.zip

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.jks
*.keystore

# Secrets — every one of these belongs in GitHub Secrets, never in the repo
*.p8
*.mobileprovision
service-account*.json

.DS_Store

# Generated by XcodeGen from project.yml at build time.
ios/LockinWidget/Info.plist
ios/LockinWatch/Widget/Info.plist
ios/**/*.entitlements

# Türetilmiş çıktı — docs/CONTENT.md kaynak, PDF ondan üretiliyor.
docs/*.pdf
